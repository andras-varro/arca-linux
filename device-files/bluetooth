#!/bin/sh
# Bluetooth at boot: the bluetooth component's kernel modules, then bluetoothd.
#
# The modules come from kernel/build-bt-modules.sh, built against OUR kernel image's symbol
# CRCs, so they load only on a unit that boots that image. It is built with
# KBUILD_BUILD_USER=arca and KBUILD_BUILD_HOST=build, which /proc/version carries as
# "(arca@build)"; on any other kernel this prints one line and loads nothing.
#
# load-order.txt is written by that same build -- dependencies first, and the crypto the
# SMP code allocates when btusb probes an adapter ahead of btusb -- so this script reads the
# order rather than restating it. Its absence means the component was never deployed.
#
# bluetoothd has no daemon() call (BlueZ 5's -n only moves its log from syslog to stderr),
# so it is backgrounded here and logs to syslog. An adapter that enumerates later is claimed
# by btusb and announced to bluetoothd over mgmt, so neither has to wait for the dongle.
# stop matches bluetoothd on its executable through /proc/*/exe, never on a process name.
#
# bluealsa (the A2DP source that ALSA clients reach as the "bluealsa" PCM) follows it, also
# backgrounded, logging to syslog with -S. It is GIO: the vendor libgio's compiled-in system
# bus is /var/run/dbus/system_bus_socket, which does not exist here, so the address is
# exported. It registers its endpoints whenever org.bluez appears, so it need not wait for
# bluetoothd. hfp-ag is there for reconnection, not for calls: measured on .188 with a Sony
# WI-C310, a bonded headset powered on again pages back only a host that offers the
# Handsfree Audio Gateway -- A2DP alone, the btmon capture shows no Connect Request at all;
# with hfp-ag it connects within seconds. It needs rfcomm.ko (kernel/build-bt-modules.sh).
#
# Reconnecting bonded devices is this script's job, because BlueZ 5.66 never pages a BR/EDR
# device on its own initiative except after a link loss within one adapter's lifetime:
# plugins/policy.c's ReconnectUUIDs fires only on a supervision timeout and keeps its list in
# memory, profiles/input/device.c's reconnect timer likewise only on an HID disconnect, and
# src/device.c's device_set_auto_connect returns early for a device that is not LE. So after a
# panel boot, or after hci0 is re-created (the dongle re-enumerates with the USB tree), nothing
# reconnects unless the remote end pages us. start therefore backgrounds "watch": it polls
# hci0's sysfs inode, which kernfs allocates afresh for every new hci0 (measured on .188:
# 21695 before a restart that reloads btusb, 22727 after), and on each new one waits for
# bluetoothd's AutoEnable to power the adapter, then calls Device1.Connect on every
# trusted, bonded device that is not connected, for a few rounds. dbus-send, not
# bluetoothctl: bluetoothctl's non-interactive connect exits 0 on failure and sits out its
# whole --timeout, while Device1.Connect returns an error in ~5 s on a page timeout.
#
# start exits 0 whatever happens: a unit with no dongle and no modules must still boot.

MODDIR=/lib/modules/4.14.52/bt
ORDER="$MODDIR/load-order.txt"
DAEMON=/usr/libexec/bluetooth/bluetoothd
# Plugins this kernel cannot serve, each of which logs an error at every start: the LE-audio
# trio needs -E (experimental D-Bus), network needs bnep.ko, which is not built. Measured on
# .188: with this list bluetoothd logs "Excluding (cli) <name>" at info level instead.
NOPLUGIN=vcp,mcp,bap,network
BLUEALSA=/usr/bin/bluealsa
# Pairing records. bluetoothd creates what it needs below this, but not this itself.
STORAGE=${BT_STORAGE:-/var/lib/bluetooth}
# The adapter is named after the unit's hostname, so two units are told apart in a scan.
# 5.66 does not expand %h in main.conf (measured on .188: the adapter advertised "%h"), so
# start writes a copy of the installed main.conf with Name= added to tmpfs and starts
# bluetoothd on it with -f. The installed file stays verbatim; a renamed host is picked up
# at the next start.
CONF=/etc/bluetooth/main.conf
RUNCONF=/var/run/bluetooth-main.conf

our_kernel() { grep -q '(arca@build)' /proc/version 2>/dev/null; }

# PIDs of every running process whose executable is named $1, whichever path it was started from.
exe_pids() {
  for e in /proc/[0-9]*/exe; do
    t=$(readlink "$e" 2>/dev/null) || continue
    [ "${t##*/}" = "$1" ] || continue
    p=${e#/proc/}; echo "${p%/exe}"
  done
}
daemon_pids() { exe_pids bluetoothd; }

# kill, then wait up to 5 s for every process named $1 to exit.
stop_exe() {
  pids=$(exe_pids "$1")
  [ -n "$pids" ] || return 0
  # shellcheck disable=SC2086 # one word per PID
  kill $pids 2>/dev/null
  i=0
  while [ -n "$(exe_pids "$1")" ] && [ "$i" -lt 5 ]; do
    sleep 1
    i=$((i + 1))
  done
  [ -z "$(exe_pids "$1")" ] || echo "  $1 did not exit (pid $(exe_pids "$1"))"
}

start_bluealsa() {
  if [ ! -x "$BLUEALSA" ]; then
    echo "  $BLUEALSA absent (BlueALSA not deployed to this unit)"
    return 0
  fi
  pids=$(exe_pids bluealsa)
  if [ -n "$pids" ]; then
    echo "  bluealsa already running (pid $pids)"
    return 0
  fi
  DBUS_SYSTEM_BUS_ADDRESS=unix:path=/run/dbus/system_bus_socket \
    "$BLUEALSA" -S -p a2dp-source -p hfp-ag </dev/null >/dev/null 2>&1 &
  echo "  bluealsa started (pid $!)"
}

# ── reconnecting bonded devices (see the header) ──
HCI=hci0
BUS=unix:path=/run/dbus/system_bus_socket
WATCHPID=/var/run/bluetooth-watch.pid
# Seconds to wait before each connect round. The first gives bluealsa time to register its
# endpoints once bluetoothd is up; a device found connected is skipped in later rounds.
ROUNDS="5 15 45"

log() { logger -t bluetooth -p daemon.notice "$*" 2>/dev/null; }

# Addresses of adapter $1's devices that bluetoothd stored as trusted, not blocked, with a
# link key -- one per line. Reads the storage files, so it needs no running daemon.
candidates() {
  [ -n "$1" ] || return 0
  for info in "$STORAGE/$1"/*/info; do
    [ -f "$info" ] || continue
    awk '/^\[/ { s = $0; next }
         s == "[General]" && $0 == "Trusted=true" { t = 1 }
         s == "[General]" && $0 == "Blocked=true" { b = 1 }
         s == "[LinkKey]" { k = 1 }
         END { exit !(t && k && !b) }' "$info" || continue
    d=${info%/info}; echo "${d##*/}"
  done
}

bus() { DBUS_SYSTEM_BUS_ADDRESS=$BUS dbus-send --system --print-reply --dest=org.bluez "$@" 2>/dev/null; }
# <object path> <interface> <property>
prop() { bus "$1" org.freedesktop.DBus.Properties.Get "string:$2" "string:$3"; }

# One pass over the bonded devices: wait for the adapter to be powered, then connect.
reconnect_all() {
  i=0
  until prop "/org/bluez/$HCI" org.bluez.Adapter1 Powered | grep -q 'boolean true'; do
    i=$((i + 1))
    [ "$i" -le 30 ] || { log "reconnect: $HCI never powered, giving up"; return; }
    sleep 1
  done
  addr=$(prop "/org/bluez/$HCI" org.bluez.Adapter1 Address | sed -n 's/.*string "\(.*\)".*/\1/p')
  [ -n "$addr" ] || return
  for wait in $ROUNDS; do
    sleep "$wait"
    left=0
    for d in $(candidates "$addr"); do
      p="/org/bluez/$HCI/dev_$(echo "$d" | tr : _)"
      prop "$p" org.bluez.Device1 Connected | grep -q 'boolean true' && continue
      if bus --reply-timeout=30000 "$p" org.bluez.Device1.Connect >/dev/null; then
        log "reconnect: $d connected"
      else
        left=$((left + 1))
      fi
    done
    [ "$left" -gt 0 ] || return
  done
  log "reconnect: $left bonded device(s) did not answer (off or out of range)"
}

# Runs until killed: a reconnect pass for every new instance of hci0, the first included.
watch() {
  echo $$ > "$WATCHPID"
  last=
  while :; do
    tok=$(stat -L -c %i "/sys/class/bluetooth/$HCI" 2>/dev/null)
    if [ -n "$tok" ] && [ "$tok" != "$last" ]; then
      last=$tok
      log "reconnect: $HCI appeared (inode $tok)"
      reconnect_all
    fi
    sleep 3
  done
}

# The watcher's PID, if one is running: the pidfile's process, checked by its command line.
watch_pid() {
  p=$(cat "$WATCHPID" 2>/dev/null) || return 0
  tr '\0' ' ' < "/proc/$p/cmdline" 2>/dev/null | grep -q ' watch' && echo "$p"
}

start_watch() {
  p=$(watch_pid)
  if [ -n "$p" ]; then
    echo "  reconnect watcher already running (pid $p)"
    return 0
  fi
  "$0" watch </dev/null >/dev/null 2>&1 &
  echo "  reconnect watcher started (pid $!)"
}

is_loaded() { lsmod | cut -d' ' -f1 | grep -qx "$(echo "${1%.ko}" | tr - _)"; }

load_modules() {
  n=0
  while read -r ko; do
    [ -n "$ko" ] || continue
    if is_loaded "$ko"; then
      :
    elif insmod "$MODDIR/$ko" 2>/tmp/bt-insmod.err; then
      n=$((n + 1))
    else
      echo "  $ko: FAILED -- $(cat /tmp/bt-insmod.err)"
    fi
  done < "$ORDER"
  rm -f /tmp/bt-insmod.err
  echo "  $n module(s) loaded"
}

case "$1" in
  start)
    echo "Starting Bluetooth..."
    if ! our_kernel; then
      echo "  not our kernel image (/proc/version): modules not loaded"
      exit 0
    fi
    if [ ! -f "$ORDER" ]; then
      echo "  $ORDER absent (bluetooth component not deployed to this unit)"
      exit 0
    fi
    load_modules
    if [ ! -x "$DAEMON" ]; then
      echo "  $DAEMON absent (bluetooth component not deployed to this unit)"
      exit 0
    fi
    pids=$(daemon_pids)
    if [ -n "$pids" ]; then
      echo "  bluetoothd already running (pid $pids)"
    else
      mkdir -p "$STORAGE" && chmod 700 "$STORAGE"
      if sed "/^\[General\]/a Name=$(hostname)" "$CONF" > "$RUNCONF" 2>/dev/null &&
         grep -q '^Name=' "$RUNCONF"; then
        "$DAEMON" -P "$NOPLUGIN" -f "$RUNCONF" </dev/null >/dev/null 2>&1 &
      else
        "$DAEMON" -P "$NOPLUGIN" </dev/null >/dev/null 2>&1 &
      fi
      echo "  bluetoothd started (pid $!)"
    fi
    start_bluealsa
    start_watch
    ;;
  watch)
    watch
    ;;
  candidates)
    candidates "$2"
    ;;
  stop)
    echo "Stopping Bluetooth..."
    p=$(watch_pid)
    [ -z "$p" ] || kill "$p" 2>/dev/null
    rm -f "$WATCHPID"
    stop_exe bluealsa
    stop_exe bluetoothd
    # Reverse load order, so a redeploy's restart loads the new .ko files. A module in use
    # stays; rmmod's refusal is not an error here.
    if [ -f "$ORDER" ]; then
      sed '1!G;h;$!d' "$ORDER" | while read -r ko; do
        rmmod "$(echo "${ko%.ko}" | tr - _)" 2>/dev/null
      done
    fi
    ;;
  restart)
    $0 stop
    $0 start
    ;;
  status)
    if our_kernel; then echo "kernel: our image"; else echo "kernel: NOT our image -- nothing loads"; fi
    pids=$(daemon_pids)
    echo "bluetoothd: ${pids:-not running}"
    pids=$(exe_pids bluealsa)
    echo "bluealsa: ${pids:-not running}"
    p=$(watch_pid)
    echo "reconnect watcher: ${p:-not running}"
    for a in /sys/class/bluetooth/hci*; do
      [ -e "$a" ] && echo "adapter: ${a##*/}"
    done
    ;;
  *)
    echo "Usage: $0 {start|stop|restart|status}"
    exit 1
    ;;
esac
exit 0
