#!/bin/sh
### BEGIN INIT INFO
# Provides:          usb-host
# Required-Start:    $local_fs
# Required-Stop:
# Default-Start:     2 3 4 5
# Default-Stop:
# Description:       Enable USB host mode via MUSB /dev/mem patching
### END INIT INFO
#
# SysV init script for USB host mode on Arca.
# Installed to /etc/init.d/usb-host, symlinked from /etc/rc5.d/S90usb-host.
#
# The kernel reloads with original (broken) struct values on each boot,
# so this script re-applies the runtime patch every time.
#
# ── Why the port dies, and what actually revives it ─────────────────────────
#
# Traced through drivers/usb/musb/ and drivers/phy/ti/ in the vanilla 4.14.52
# tree, and consistent with every measurement on .188 2026-08-13.
# SYSTEM_ANALYSIS.md#36-usb.
#
# THE ROOT CAUSE IS ONE DTB WORD: this board declares `mode = <0x03>` on the
# musb node (MUSB_PORT_MODE_DUAL_ROLE, musb_core.h:82-84), while the kernel is
# built with `# CONFIG_USB_GADGET is not set`. So dual-role buys NOTHING that
# this kernel can use, and it costs two things:
#
#   1. musb_host_setup() only claims default_a/A_IDLE for MUSB_PORT_MODE_HOST
#      (musb_host.c:2789-2793), so probe leaves the controller in B_IDLE.
#   2. musb_start()'s guard (musb_core.c:1074-1080) skips setting DEVCTL SESSION
#      whenever port_mode != HOST and VBUS still reads valid -- see `recover`.
#
# WHAT KEEPS THE PORT ALIVE IS THE OTG ID PIN, not a device at probe. The
# TWL4030 PMIC watches ID on its OWN interrupt line (phy-twl4030-usb.c:747), in
# an always-powered PM_MASTER register (STS_HW_CONDITIONS, :298-314) -- so it
# fires with the PHY asleep, MUSB in standby, and VBUS off. Grounding ID powers
# the PHY and resumes MUSB, and the resume replays the CACHED DEVCTL SESSION bit
# (musb_core.c:2609-2610).
#
# ⚠️ ON THE VENDOR KERNEL AN ID EVENT CANNOT START A SESSION ON A COLD PORT.
# The plug does reach the glue as MUSB_ID_GROUND, but omap_musb_set_mailbox()
# (omap2430.c:171-181) sets SESSION only if musb->gadget_driver is set, and with
# CONFIG_USB_GADGET off it never is. Our own kernel image patches that guard out,
# and there an adapter plug starts the session. Measured on .188 2026-08-13,
# refuting the earlier claim that an adapter left plugged in holds the port open:
#
#   passive hub connected to a dead port, nothing else   VBUS off at 1, 2 and
#                                                        3 min, and still off
#                                                        several minutes later
#   a device then plugged into that hub                  nothing enumerates
#
# So do NOT tell an operator that leaving an adapter or hub attached fixes this.
# It does not. What it does is preserve a port that is ALREADY alive:
#
#   after `recover` succeeded, the peripheral was unplugged and replugged at
#   gaps of 70, 75, 90, 120, 150, 180, 240 and 300 s -- and worked EVERY time.
#
# That half is solid and explains itself from the source: no .try_idle in
# omap2430_ops means musb_platform_try_idle() is a no-op, so SESSION is never
# cleared once set, and each ID-ground resume replays it. The gap length was
# never the variable. A hub is irrelevant to all of this -- the PHY sees two
# bits of ID/VBUS state and no descriptors, so it cannot tell a passive adapter
# from a powered hub.
#
# ⚠️ SO THE ONE RELIABLE COLD-PORT REMEDY IS STILL A REBIND, and it has needed
# TWO consecutive runs both times it was measured. The second measurement rules
# out the obvious explanation: both of its runs started from `Vbus off`, so
# "VBUS was still valid when the driver re-probed" is NOT the general cause.
# Current hypothesis, NOT yet verified: omap2430_musb_init() replays the cached
# glue->status at probe (omap2430.c:312-313) and twl4030_phy_init() re-derives
# ID about a second later, so the first rebind is what teaches the glue layer
# the ID state and the second is the one that can use it at probe. Until that is
# confirmed, `recover` loops on the MEASUREMENT: rebind, look, stop when a
# non-hub device appears.
#
# ⚠️ AND THE EARLIER CLAIM THAT "FROM A_IDLE WITH VBUS OFF NO INTERRUPT CAN
# ARRIVE" IS WRONG. It reasoned about connect detection only and ignored the ID
# pin. musb_start() also has three call sites, not one (musb_virthub.c:398,
# :461; musb_core.c:1977 babble recovery), and the hub one is re-enterable at
# runtime via the port-over-current path (musb_core.c:711-713 -> hub.c:5079).
#
# ⚠️ FOUR THINGS THAT LOOK LIKE FIXES AND ARE NOT. All read out of the source;
# do not re-derive them:
#
#   echo host > $MUSB/mode   omap2430_ops has no .set_mode, so
#                            musb_platform_set_mode() returns 0 and the store
#                            reports SUCCESS having done nothing. Silent no-op.
#   echo N > $MUSB/vbus      sets musb->a_wait_bcon, which NOTHING on omap2430
#                            reads (no .try_idle). The "timeout 1100 msec" in
#                            its output is an untouched default.
#   power/control = on       forbidding runtime PM does not prevent the drop;
#                            measured with runtime_status active throughout.
#   twl4030_usb/vbus         read-only (0444), and it reads "off" while WE drive
#                            VBUS -- it reports vbus_supplied, i.e. somebody
#                            feeding US. Not a trigger and not a port state.
#
# The one real userspace trigger besides a rebind is debugfs `softconnect`
# (musb_debugfs.c:301-343), which sets SESSION -- but only in A_WAIT_BCON, so it
# cannot revive a port sitting in A_IDLE.
#
# ⚠️ AND `mode` IS NOT A DIAGNOSTIC. It reads a_idle with a pad enumerated and
# working. The state that distinguishes a live port from a dead one is
# $MUSB/vbus: "Vbus on" vs "Vbus off".
#
#   echo host > $MUSB/mode   omap2430_ops has no .set_mode, so
#                            musb_platform_set_mode() returns 0 and the store
#                            reports SUCCESS having done nothing. Silent no-op.
#   echo N > $MUSB/vbus      sets musb->a_wait_bcon, which NOTHING on omap2430
#                            reads (no .try_idle). The "timeout 1100 msec" in
#                            its output is an untouched default.
#   power/control = on       forbidding runtime PM does not prevent the drop;
#                            measured with runtime_status active throughout.
#
# ⚠️ AND `mode` IS NOT A DIAGNOSTIC. It reads a_idle with a pad enumerated and
# working. The state that distinguishes a live port from a dead one is
# $MUSB/vbus: "Vbus on" vs "Vbus off".

ENABLE_SCRIPT="/usr/local/bin/enable-usb-host.sh"

MUSB="/sys/devices/platform/68000000.ocp/480ab000.usb_otg_hs/musb-hdrc.0.auto"
MUSB_DEVICE="musb-hdrc.0.auto"
MUSB_DRIVER="/sys/bus/platform/drivers/musb-hdrc"

# Overridable only so usb_peripherals() is reachable from a host test with a
# synthetic sysfs tree; on the device this is never set.
USB_DEVICES_DIR="${USB_DEVICES_DIR:-/sys/bus/usb/devices}"

vbus_state() {
    if [ -r "$MUSB/vbus" ]; then
        cat "$MUSB/vbus" 2>/dev/null
    else
        echo "unknown ($MUSB/vbus absent -- MUSB not bound)"
    fi
}

# Count enumerated NON-HUB devices on bus 1.
#
# ⚠️ Do NOT test `[ -d /sys/bus/usb/devices/1-1 ]` for this. 1-1 is whatever sits
# on root-hub port 1 -- and with a hub left permanently attached (once a candidate
# fix for the dead port) that is the HUB. The old test therefore
# reported "a device is attached" with no peripheral present at all, which would
# have silently passed the hub-left-attached test itself. A hub is bDeviceClass 09; a pad is
# not. Devices behind a hub are 1-1.N and counted here too.
#
# The root hub is `usb1`, outside the 1-* glob. `1-0:1.0` and friends are
# interface directories, skipped on the colon.
usb_peripherals() {
    n=0
    for d in "$USB_DEVICES_DIR"/1-*; do
        [ -d "$d" ] || continue
        case "${d##*/}" in *:*) continue ;; esac
        [ "$(cat "$d/bDeviceClass" 2>/dev/null)" = "09" ] && continue
        n=$((n + 1))
    done
    echo "$n"
}

case "$1" in
  start)
    echo "Enabling USB host mode..."
    if [ -x "$ENABLE_SCRIPT" ]; then
        "$ENABLE_SCRIPT"
    else
        echo "ERROR: $ENABLE_SCRIPT not found or not executable"
        exit 1
    fi
    ;;
  stop)
    echo "USB host mode cannot be stopped at runtime."
    ;;
  status)
    if [ -d /sys/bus/usb/devices/usb1 ]; then
        echo "USB host mode is active."
        lsusb 2>/dev/null
    else
        echo "USB host mode is NOT active."
    fi
    # THE reading that matters -- "Vbus off" means the port is unpowered and
    # nothing plugged into it will ever be seen until a rebind.
    echo "VBUS: $(vbus_state)"
    # Counted separately from lsusb because a hub is not a peripheral: during
    # the hub-left-attached test the interesting question is "is anything there BESIDES the
    # hub", and lsusb's line count cannot answer it at a glance.
    echo "Non-hub devices: $(usb_peripherals)"
    ;;
  restart)
    # enable-usb-host.sh is idempotent, so restart just calls start
    "$0" start
    ;;
  recover)
    # Re-probe the MUSB driver, which re-runs the root hub's port-power path and
    # so re-asserts the session. Plug the device in FIRST, then run this.
    #
    # ⚠️ ONE REBIND IS NOT RELIABLE -- retry until a peripheral appears. Measured
    # on .188 2026-08-13 with the pad attached THROUGHOUT: the first rebind
    # failed and the second succeeded. The asymmetry tracked VBUS at unbind time:
    #
    #   attempt 1   VBUS before: Vbus on    -> VBUS after: Vbus off   FAILED
    #   attempt 2   VBUS before: Vbus off   -> VBUS after: Vbus on    enumerated
    #
    # so a rebind that starts from a live session appears not to assert a fresh
    # one, and the failing attempt is what leaves VBUS off for the next to
    # succeed from. The mechanism is not yet traced in the source, so this loops
    # on the MEASUREMENT rather than on a theory: rebind, look for a non-hub
    # device, stop the moment there is one.
    #
    # ⚠️ Deliberately NOT run on a timer. With nothing attached every rebind
    # leaves the port dead again within seconds and logs four kernel lines, so a
    # poll would rebind forever. Worse, nothing in software can tell "nothing is
    # plugged in" from "a pad is plugged into an unpowered port" -- VBUS is off
    # either way and no connect interrupt can arrive in either. An operator who
    # has just plugged something in holds the one bit no poll can obtain, which
    # is why this is a command and not a daemon.
    #
    # Measured on .188 2026-09-29, our 4.14.52 image with the DISCONNECT patch:
    # an empty-socket rebind logs 7 kernel lines and leaves "Vbus off"; a hub
    # plugged ~1.5 min later raised nothing at all (0 lines, still off), and
    # `recover` then needed attempt 2 to enumerate it. A full-tree rebind logs
    # ~37 lines. So a timed rebind catches only what is present AT a rebind, and
    # each catch costs two ~6 s rebinds -- a poll was rejected on those numbers.
    # ⚠️ THE UNBIND AND THE BIND ARE SEPARATED BY A DELAY, but do NOT record that
    # as the fix for the double-run -- see the header. It addresses ONE real
    # mechanism, which is not the only one. musb_start(), musb_core.c:1074-1080:
    #
    #     devctl &= ~MUSB_DEVCTL_SESSION;
    #     if (musb->port_mode != MUSB_PORT_MODE_HOST &&
    #             musb->xceiv->otg->state != OTG_STATE_A_WAIT_BCON &&
    #             (devctl & MUSB_DEVCTL_VBUS) == MUSB_DEVCTL_VBUS) {
    #             musb->is_active = 1;
    #     } else {
    #             devctl |= MUSB_DEVCTL_SESSION;
    #     }
    #
    # This board's DTB says `mode = <0x03>` (MUSB_PORT_MODE_DUAL_ROLE,
    # musb_core.h:82-84), so the first clause is TRUE. If VBUS still reads above
    # VBusValid when the driver re-probes, SESSION is left CLEARED and the bind
    # "succeeds" having enumerated nothing. Letting VBUS decay first removes that
    # failure mode, and it is free.
    #
    # ⚠️ It is NOT sufficient, though: a second measurement had BOTH runs start
    # from `Vbus off` and the first still failed, so something else is also at
    # work. Hence the retry, which loops on the measurement rather than on any
    # one theory.
    #
    # $MUSB/vbus cannot be polled in the gap -- it is an attribute of the bound
    # driver and disappears with it -- hence a fixed settle.
    if [ ! -d "$MUSB_DRIVER" ]; then
        echo "ERROR: $MUSB_DRIVER absent -- the musb-hdrc driver is not loaded."
        exit 1
    fi

    tries="${RECOVER_TRIES:-3}"
    settle="${RECOVER_SETTLE:-2}"
    attempt=1
    while [ "$attempt" -le "$tries" ]; do
        echo "--- attempt $attempt of $tries"
        echo "VBUS before: $(vbus_state)"
        echo "Unbinding $MUSB_DEVICE, letting VBUS decay ${settle}s, rebinding..."
        echo "$MUSB_DEVICE" > "$MUSB_DRIVER/unbind" 2>/dev/null
        sleep "$settle"
        echo "$MUSB_DEVICE" > "$MUSB_DRIVER/bind" 2>/dev/null
        sleep 3
        echo "VBUS after:  $(vbus_state)"
        if [ "$(usb_peripherals)" -gt 0 ]; then
            lsusb 2>/dev/null
            echo "A device is attached and enumerated (attempt $attempt)."
            exit 0
        fi
        attempt=$((attempt + 1))
    done

    lsusb 2>/dev/null
    echo "No non-hub device enumerated after $tries attempt(s)."
    echo "If one IS plugged in, check dmesg. Note that a hub or adapter left"
    echo "attached does NOT revive a dead port -- measured -- so there"
    echo "is nothing to re-seat your way out of; a rebind is the remedy."
    exit 1
    ;;
  *)
    echo "Usage: $0 {start|stop|status|restart|recover}"
    exit 1
    ;;
esac
