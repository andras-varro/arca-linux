#!/bin/sh
# /etc/init.d/arcamond — boot start for the Monitor page's history daemon.
#
# arcamond samples CPU, memory and SoC temperature once a second into a two
# minute ring at /var/run/arcamond.ring (tmpfs), which control_panel's Monitor
# page reads on open.  The binary is a native_apps deploy (/opt/games/arcamond);
# on a unit without it this prints one line and does nothing.  It niced itself
# to 19 and opens no framebuffer or input device.
#
# arca-app stop leaves it running (app_pids skips it), so native_apps/build-and-deploy.sh
# stops it itself before the upload and calls "start" again after the launcher restart.

DAEMON=/opt/games/arcamond
PIDFILE=/var/run/arcamond.pid

running() {
    [ -f "$PIDFILE" ] || return 1
    _pid=$(cat "$PIDFILE" 2>/dev/null)
    [ -n "$_pid" ] && [ "$(readlink "/proc/$_pid/exe" 2>/dev/null)" = "$DAEMON" ]
}

do_start() {
    if [ ! -x "$DAEMON" ]; then
        echo "arcamond: $DAEMON not installed (deploy native_apps)"
        return 0
    fi
    if running; then
        echo "arcamond: already running (pid $(cat "$PIDFILE"))"
        return 0
    fi
    start-stop-daemon --start --background --make-pidfile --pidfile "$PIDFILE" \
        --exec "$DAEMON"
    echo "arcamond: started"
}

do_stop() {
    if running; then
        kill "$(cat "$PIDFILE")" 2>/dev/null
    fi
    rm -f "$PIDFILE"
    echo "arcamond: stopped"
}

case "$1" in
    start)   do_start ;;
    stop)    do_stop ;;
    restart) do_stop; sleep 1; do_start ;;
    status)
        if running; then echo "arcamond: running (pid $(cat "$PIDFILE"))"
        else echo "arcamond: not running"; exit 1; fi ;;
    *) echo "Usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac
exit 0
