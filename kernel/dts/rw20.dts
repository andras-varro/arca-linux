// SPDX-License-Identifier: GPL-2.0-only
/*
 * rw20: the Steelcase RoomWizard 20 wall display, as the board our 4.14.52 image boots on.
 *
 * TI OMAP3503 (OMAP34xx dtsi), 256 MB RAM at 0x80000000, TWL4030 PMIC on I2C1, a 800x480 LVDS
 * panel on the DSS DPI port driven by the stock panel-dpi driver, an SMSC LAN9221 and a NAND on
 * the GPMC, one SD slot (MMC1), the console on UART2 (ttyO1), the USB OTG port on the TWL4030
 * PHY with the host controller's two ports in PHY mode, and LEDs and backlight driven by three
 * dmtimer PWMs. Authored from board facts (addresses, GPIO lines, pad settings and panel timing
 * measured on a unit; SYSTEM_ANALYSIS.md, HARDWARE.md), on top of the mainline dtsi files.
 *
 * Built by kernel/build-image.sh with the kernel tree's own include path and appended to
 * zImage. The bootloader fills /chosen (bootargs) at boot; nothing here sets it.
 */

/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/pinctrl/omap.h>

#include "omap34xx.dtsi"

/ {
	model = "Steelcase RoomWizard 20";
	compatible = "ti,omap3-rw20", "ti,omap3";

	/*
	 * The TWL4030 is I2C bus 1 here, and the whole userspace (/dev/i2c-1 for the PMIC)
	 * counts that way. The mainline dtsi numbers its buses from 0, so those aliases go.
	 */
	aliases {
		/delete-property/ i2c0;
		display0 = &lcd0;
		i2c1 = &i2c1;
		i2c2 = &i2c2;
		i2c3 = &i2c3;
	};

	cpus {
		cpu@0 {
			cpu0-supply = <&vcc>;
		};
	};

	memory {
		device_type = "memory";
		reg = <0x80000000 0x10000000>;
	};

	/* The LCD logic supply: a fixed 3.3 V rail, no switch. */
	lcd_3v3: regulator-lcd-3v3 {
		compatible = "regulator-fixed";
		regulator-name = "lcd_3v3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		startup-delay-us = <70000>;
	};

	/* The two supply rails the LAN9221 driver asks for by name. */
	vddvario: regulator-vddvario {
		compatible = "regulator-fixed";
		regulator-name = "vddvario";
		regulator-always-on;
	};

	vdd33a: regulator-vdd33a {
		compatible = "regulator-fixed";
		regulator-name = "vdd33a";
		regulator-always-on;
	};

	/*
	 * The 800x480 panel on the DPI port, claimed by omapfb's panel-dpi. That driver drives only
	 * enable-gpios (gpio1 line 14, power-down). The LVDS transmitter (line 15) and the backlight
	 * switch (line 19) are held high by hogs on &gpio1 below. The timings are the panel's own;
	 * omapfb sizes fb0 from data-lines, and syncclk-active is honoured by
	 * kernel/patches/omapdss-honour-syncclk-active.patch.
	 */
	lcd0: display {
		compatible = "panel-dpi";
		label = "lcd";
		data-lines = <24>;
		enable-gpios = <&gpio1 14 GPIO_ACTIVE_HIGH>;
		pwrdn-gpios = <&gpio1 14 GPIO_ACTIVE_HIGH>;
		lvds-gpios = <&gpio1 15 GPIO_ACTIVE_HIGH>;
		backlight-gpios = <&gpio1 19 GPIO_ACTIVE_HIGH>;
		power-supply = <&lcd_3v3>;

		panel-timing {
			clock-frequency = <33230770>;
			hactive = <800>;
			vactive = <480>;
			hsync-len = <128>;
			hfront-porch = <40>;
			hback-porch = <88>;
			vsync-len = <9>;
			vfront-porch = <9>;
			vback-porch = <26>;
			hsync-active = <0>;
			vsync-active = <0>;
			de-active = <1>;
			pixelclk-active = <1>;
			syncclk-active = <0>;
		};

		port {
			lcd_in: endpoint {
				remote-endpoint = <&dpi_out>;
			};
		};
	};

	/*
	 * Backlight and the two LED colours are PWM outputs of GPTIMER9, 10 and 11 (800 Hz). The
	 * node names carry the timer number without a reg, as the userspace-visible platform device
	 * names do.
	 */
	pwm9: dmtimer-pwm@9 {
		compatible = "ti,omap-dmtimer-pwm";
		#pwm-cells = <3>;
		ti,timers = <&timer9>;
		pinctrl-names = "default";
		pinctrl-0 = <&pinmux_backlight_pin>;
		status = "okay";
	};

	pwm10: dmtimer-pwm@10 {
		compatible = "ti,omap-dmtimer-pwm";
		#pwm-cells = <3>;
		ti,timers = <&timer10>;
		pinctrl-names = "default";
		pinctrl-0 = <&pinmux_red_led_pin>;
		status = "okay";
	};

	pwm11: dmtimer-pwm@11 {
		compatible = "ti,omap-dmtimer-pwm";
		#pwm-cells = <3>;
		ti,timers = <&timer11>;
		pinctrl-names = "default";
		pinctrl-0 = <&pinmux_green_led_pin>;
		status = "okay";
	};

	pwmleds {
		compatible = "pwm-leds";

		backlight {
			pwms = <&pwm9 0 1250000 0>;
			pwm-names = "backlight";
			max-brightness = <100>;
			brightness = <100>;
		};

		green_led {
			pwms = <&pwm11 0 1250000 0>;
			pwm-names = "green_led";
			max-brightness = <100>;
			brightness = <50>;
		};

		red_led {
			pwms = <&pwm10 0 1250000 0>;
			pwm-names = "red_led";
			max-brightness = <100>;
			brightness = <50>;
		};
	};

	/* The speaker amplifier is muted by gpio12; the mute pad is set up as GPIO output. */
	sound {
		compatible = "ti,omap-twl4030";
		ti,model = "rw20";
		ti,mcbsp = <&mcbsp2>;
		pinctrl-names = "default";
		pinctrl-0 = <&pinmux_spk_mute_pins>;
	};

	/* omap3.dtsi's PMU names no CPU for its interrupt, so perf logs "guessing" at boot. */
	pmu@54000000 {
		interrupt-affinity = <&cpu>;
	};
};

/*
 * Pad configuration. Core pads sit at 0x48002030 + offset (OMAP3_CORE1_IOPAD takes the absolute
 * address); the second block starting at 0x480025d8 holds the ETK pads used as GPIOs.
 */
&omap3_pmx_core {
	pinmux_backlight_pin: pinmux_backlight_pin {
		pinctrl-single,pins = <
			OMAP3_CORE1_IOPAD(0x21d8, PIN_OUTPUT | MUX_MODE1)	/* mcspi2_simo.gpt9_pwm_evt */
		>;
	};

	pinmux_red_led_pin: pinmux_red_led_pin {
		pinctrl-single,pins = <
			OMAP3_CORE1_IOPAD(0x21da, PIN_OUTPUT | MUX_MODE1)	/* mcspi2_somi.gpt10_pwm_evt */
		>;
	};

	pinmux_green_led_pin: pinmux_green_led_pin {
		pinctrl-single,pins = <
			OMAP3_CORE1_IOPAD(0x21dc, PIN_OUTPUT | MUX_MODE1)	/* mcspi2_cs0.gpt11_pwm_evt */
		>;
	};

	pinmux_dss_dpi_pins: pinmux_dss_dpi_pins {
		pinctrl-single,pins = <
			OMAP3_CORE1_IOPAD(0x20d4, PIN_OUTPUT | MUX_MODE0)	/* dss_pclk.dss_pclk */
			OMAP3_CORE1_IOPAD(0x20d6, PIN_OUTPUT | MUX_MODE0)	/* dss_hsync.dss_hsync */
			OMAP3_CORE1_IOPAD(0x20d8, PIN_OUTPUT | MUX_MODE0)	/* dss_vsync.dss_vsync */
			OMAP3_CORE1_IOPAD(0x20da, PIN_OUTPUT | MUX_MODE0)	/* dss_acbias.dss_acbias */
			OMAP3_CORE1_IOPAD(0x20dc, PIN_OUTPUT | MUX_MODE0)	/* dss_data0.dss_data0 */
			OMAP3_CORE1_IOPAD(0x20de, PIN_OUTPUT | MUX_MODE0)	/* dss_data1.dss_data1 */
			OMAP3_CORE1_IOPAD(0x20e0, PIN_OUTPUT | MUX_MODE0)	/* dss_data2.dss_data2 */
			OMAP3_CORE1_IOPAD(0x20e2, PIN_OUTPUT | MUX_MODE0)	/* dss_data3.dss_data3 */
			OMAP3_CORE1_IOPAD(0x20e4, PIN_OUTPUT | MUX_MODE0)	/* dss_data4.dss_data4 */
			OMAP3_CORE1_IOPAD(0x20e6, PIN_OUTPUT | MUX_MODE0)	/* dss_data5.dss_data5 */
			OMAP3_CORE1_IOPAD(0x20e8, PIN_OUTPUT | MUX_MODE0)	/* dss_data6.dss_data6 */
			OMAP3_CORE1_IOPAD(0x20ea, PIN_OUTPUT | MUX_MODE0)	/* dss_data7.dss_data7 */
			OMAP3_CORE1_IOPAD(0x20ec, PIN_OUTPUT | MUX_MODE0)	/* dss_data8.dss_data8 */
			OMAP3_CORE1_IOPAD(0x20ee, PIN_OUTPUT | MUX_MODE0)	/* dss_data9.dss_data9 */
			OMAP3_CORE1_IOPAD(0x20f0, PIN_OUTPUT | MUX_MODE0)	/* dss_data10.dss_data10 */
			OMAP3_CORE1_IOPAD(0x20f2, PIN_OUTPUT | MUX_MODE0)	/* dss_data11.dss_data11 */
			OMAP3_CORE1_IOPAD(0x20f4, PIN_OUTPUT | MUX_MODE0)	/* dss_data12.dss_data12 */
			OMAP3_CORE1_IOPAD(0x20f6, PIN_OUTPUT | MUX_MODE0)	/* dss_data13.dss_data13 */
			OMAP3_CORE1_IOPAD(0x20f8, PIN_OUTPUT | MUX_MODE0)	/* dss_data14.dss_data14 */
			OMAP3_CORE1_IOPAD(0x20fa, PIN_OUTPUT | MUX_MODE0)	/* dss_data15.dss_data15 */
			OMAP3_CORE1_IOPAD(0x20fc, PIN_OUTPUT | MUX_MODE0)	/* dss_data16.dss_data16 */
			OMAP3_CORE1_IOPAD(0x20fe, PIN_OUTPUT | MUX_MODE0)	/* dss_data17.dss_data17 */
			OMAP3_CORE1_IOPAD(0x2100, PIN_OUTPUT | MUX_MODE0)	/* dss_data18.dss_data18 */
			OMAP3_CORE1_IOPAD(0x2102, PIN_OUTPUT | MUX_MODE0)	/* dss_data19.dss_data19 */
			OMAP3_CORE1_IOPAD(0x2104, PIN_OUTPUT | MUX_MODE0)	/* dss_data20.dss_data20 */
			OMAP3_CORE1_IOPAD(0x2106, PIN_OUTPUT | MUX_MODE0)	/* dss_data21.dss_data21 */
			OMAP3_CORE1_IOPAD(0x2108, PIN_OUTPUT | MUX_MODE0)	/* dss_data22.dss_data22 */
			OMAP3_CORE1_IOPAD(0x210a, PIN_OUTPUT | MUX_MODE0)	/* dss_data23.dss_data23 */
		>;
	};

	/* gpmc_ncs5: the chip select the LAN9221 sits on */
	pinmux_gpmc_pins: pinmux_gpmc_pins {
		pinctrl-single,pins = <
			OMAP3_CORE1_IOPAD(0x20b8, PIN_OUTPUT | MUX_MODE0)	/* gpmc_ncs5.gpmc_ncs5 */
		>;
	};

	pinmux_hsusb_otg_pins: pinmux_hsusb_otg_pins {
		pinctrl-single,pins = <
			OMAP3_CORE1_IOPAD(0x21a2, PIN_INPUT | MUX_MODE0)	/* hsusb0_clk.hsusb0_clk */
			OMAP3_CORE1_IOPAD(0x21a4, PIN_OUTPUT | MUX_MODE0)	/* hsusb0_stp.hsusb0_stp */
			OMAP3_CORE1_IOPAD(0x21a6, PIN_INPUT | MUX_MODE0)	/* hsusb0_dir.hsusb0_dir */
			OMAP3_CORE1_IOPAD(0x21a8, PIN_INPUT | MUX_MODE0)	/* hsusb0_nxt.hsusb0_nxt */
			OMAP3_CORE1_IOPAD(0x21aa, PIN_INPUT | MUX_MODE0)	/* hsusb0_data0.hsusb0_data0 */
			OMAP3_CORE1_IOPAD(0x21ac, PIN_INPUT | MUX_MODE0)	/* hsusb0_data1.hsusb0_data1 */
			OMAP3_CORE1_IOPAD(0x21ae, PIN_INPUT | MUX_MODE0)	/* hsusb0_data2.hsusb0_data2 */
			OMAP3_CORE1_IOPAD(0x21b0, PIN_INPUT | MUX_MODE0)	/* hsusb0_data3.hsusb0_data3 */
			OMAP3_CORE1_IOPAD(0x21b2, PIN_INPUT | MUX_MODE0)	/* hsusb0_data4.hsusb0_data4 */
			OMAP3_CORE1_IOPAD(0x21b4, PIN_INPUT | MUX_MODE0)	/* hsusb0_data5.hsusb0_data5 */
			OMAP3_CORE1_IOPAD(0x21b6, PIN_INPUT | MUX_MODE0)	/* hsusb0_data6.hsusb0_data6 */
			OMAP3_CORE1_IOPAD(0x21b8, PIN_INPUT | MUX_MODE0)	/* hsusb0_data7.hsusb0_data7 */
		>;
	};

	pinmux_i2c1_pins: pinmux_i2c1_pins {
		pinctrl-single,pins = <
			OMAP3_CORE1_IOPAD(0x21ba, PIN_INPUT | MUX_MODE0)	/* i2c1_scl.i2c1_scl */
			OMAP3_CORE1_IOPAD(0x21bc, PIN_INPUT | MUX_MODE0)	/* i2c1_sda.i2c1_sda */
		>;
	};

	pinmux_i2c2_pins: pinmux_i2c2_pins {
		pinctrl-single,pins = <
			OMAP3_CORE1_IOPAD(0x21be, PIN_INPUT | MUX_MODE0)	/* i2c2_scl.i2c2_scl */
			OMAP3_CORE1_IOPAD(0x21c0, PIN_INPUT | MUX_MODE0)	/* i2c2_sda.i2c2_sda */
		>;
	};

	/* The SD slot's card-detect switch, read as a GPIO (see &mmc1) */
	pinmux_mmc1_cd_pin: pinmux_mmc1_cd_pin {
		pinctrl-single,pins = <
			OMAP3_CORE1_IOPAD(0x2150, PIN_INPUT | MUX_MODE4)	/* sdmmc1_dat4.gpio_126 */
		>;
	};

	pinmux_uart2_pins: pinmux_uart2_pins {
		pinctrl-single,pins = <
			OMAP3_CORE1_IOPAD(0x2170, PIN_OUTPUT | MUX_MODE1)	/* mcbsp3_clkx.uart2_tx */
			OMAP3_CORE1_IOPAD(0x2172, PIN_INPUT | MUX_MODE1)	/* mcbsp3_fsx.uart2_rx */
		>;
	};
};

/* The ETK pads, used as GPIO lines 12 to 19 of bank 1 */
&omap3_pmx_core2 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinmux_lcd_pins>;

	/* gpio17 is the LAN9221 reset (output); gpio18 its interrupt (input) */
	pinmux_lan_pins: pinmux_lan_pins {
		pinctrl-single,pins = <
			OMAP3430_CORE2_IOPAD(0x25e4, INPUT_EN | PULL_UP | MUX_MODE4)	/* etk_d4.gpio_18 */
			OMAP3430_CORE2_IOPAD(0x25e2, PIN_OUTPUT | MUX_MODE4)		/* etk_d3.gpio_17 */
		>;
	};

	/* gpio14 panel power-down, gpio15 LVDS transmitter, gpio19 backlight switch */
	pinmux_lcd_pins: pinmux_lcd_pins {
		pinctrl-single,pins = <
			OMAP3430_CORE2_IOPAD(0x25dc, PIN_OUTPUT | MUX_MODE4)	/* etk_d0.gpio_14 */
			OMAP3430_CORE2_IOPAD(0x25de, PIN_OUTPUT | MUX_MODE4)	/* etk_d1.gpio_15 */
			OMAP3430_CORE2_IOPAD(0x25e6, PIN_OUTPUT | MUX_MODE4)	/* etk_d5.gpio_19 */
		>;
	};

	pinmux_spk_mute_pins: pinmux_spk_mute_pins {
		pinctrl-single,pins = <
			OMAP3430_CORE2_IOPAD(0x25d8, PIN_OUTPUT | MUX_MODE4)	/* etk_clk.gpio_12 */
		>;
	};

	pinmux_ts_rst_pins: pinmux_ts_rst_pins {
		pinctrl-single,pins = <
			OMAP3430_CORE2_IOPAD(0x25e0, PIN_OUTPUT | MUX_MODE4)	/* etk_d2.gpio_16 */
		>;
	};

	pinmux_vbus_enable_pins: pinmux_vbus_enable_pins {
		pinctrl-single,pins = <
			OMAP3430_CORE2_IOPAD(0x25da, PIN_OUTPUT | MUX_MODE4)	/* etk_ctl.gpio_13 */
		>;
	};
};

/* The LCD transmitter and the backlight switch are on from the moment gpio1 probes. */
&gpio1 {
	lcd-lvds-hog {
		gpio-hog;
		gpios = <15 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "lcd-lvds";
	};

	lcd-backlight-hog {
		gpio-hog;
		gpios = <19 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "lcd-backlight";
	};
};

&dss {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&pinmux_dss_dpi_pins>;
	vdds_dsi-supply = <&vpll2>;
	vdda_video-supply = <&lcd_3v3>;

	port {
		dpi_out: endpoint {
			remote-endpoint = <&lcd_in>;
			data-lines = <24>;
		};
	};
};

/*
 * LAN9221 on chip select 5 and NAND on chip select 0. The NAND is the vendor's: its partition
 * table is kept so the layout stays documented, nothing in our image mounts it.
 */
&gpmc {
	ranges = <5 0 0x2c000000 0x1000000>,
		 <0 0 0x30000000 0x1000000>;

	ethernet@gpmc {
		compatible = "smsc,lan9221", "smsc,lan9115";
		reg = <5 0 0xff>;
		bank-width = <2>;
		reg-io-width = <4>;
		smsc,save-mac-address;

		pinctrl-names = "default";
		pinctrl-0 = <&pinmux_lan_pins>;
		pinctrl-1 = <&pinmux_gpmc_pins>;
		interrupt-parent = <&gpio1>;
		interrupts = <18 IRQ_TYPE_LEVEL_LOW>;
		reset-gpios = <&gpio1 17 GPIO_ACTIVE_HIGH>;
		vddvario-supply = <&vddvario>;
		vdd33a-supply = <&vdd33a>;

		/*
		 * Timings tightened from the vendor's (cs/oe/we off 150/140, cycles 155, access 120,
		 * turnaround and cycle-to-cycle 75). Measured at runtime on a unit with the same registers
		 * written by devmem: Ethernet RX 5.0-5.7 -> 7.2-9.0 MB/s, TX 3.4 -> 4.8 MB/s, no errors.
		 * GPMC_FCLK is the 166 MHz L3 clock (6.024 ns/tick, inferred from "Core 332 MHz"; the
		 * live registers matched the old values rounded up at that tick), and the driver rounds
		 * every ns value up to whole ticks, so these give CONFIG2 00090901, CONFIG4 09020902,
		 * CONFIG5 04080C0C, CONFIG6 800002C2. Against LAN9221 DS00002416A tables 6-3 and 6-7:
		 * nCS+nRD (or nWR) asserted 42 ns (min 32); read and write cycle 72 (min 45);
		 * deasserted 24 (min 13); read data is sampled at 48 and the chip has it 30 ns after nRD
		 * falls at 12, i.e. by 42 (tcsdv max 30); write data setup >= 42 (min 7).
		 * Read data margin is the tightest (6 ns): do not shorten access-ns or lengthen oe-on-ns.
		 */
		gpmc,device-width = <1>;
		gpmc,cs-on-ns = <5>;
		gpmc,cs-rd-off-ns = <54>;
		gpmc,cs-wr-off-ns = <54>;
		gpmc,adv-on-ns = <0>;
		gpmc,adv-rd-off-ns = <15>;
		gpmc,adv-wr-off-ns = <40>;
		gpmc,oe-on-ns = <12>;
		gpmc,oe-off-ns = <54>;
		gpmc,we-on-ns = <12>;
		gpmc,we-off-ns = <54>;
		gpmc,rd-cycle-ns = <72>;
		gpmc,wr-cycle-ns = <72>;
		gpmc,access-ns = <48>;
		gpmc,wr-access-ns = <0>;
		gpmc,page-burst-access-ns = <20>;
		gpmc,bus-turnaround-ns = <12>;
		gpmc,cycle2cycle-delay-ns = <12>;
		gpmc,cycle2cycle-samecsen = <1>;
		gpmc,cycle2cycle-diffcsen = <1>;
		gpmc,clk-activation-ns = <0>;
		gpmc,wait-monitoring-ns = <0>;
		gpmc,wr-data-mux-bus-ns = <0>;
	};

	nand@0,0 {
		compatible = "ti,omap2-nand";
		reg = <0 0 4>;
		#address-cells = <1>;
		#size-cells = <1>;
		linux,mtd-name = "micron,nand";
		nand-bus-width = <16>;
		ti,nand-ecc-opt = "bch8";

		gpmc,device-width = <2>;
		gpmc,sync-clk-ps = <0>;
		gpmc,cs-on-ns = <0>;
		gpmc,cs-rd-off-ns = <44>;
		gpmc,cs-wr-off-ns = <44>;
		gpmc,adv-on-ns = <6>;
		gpmc,adv-rd-off-ns = <34>;
		gpmc,adv-wr-off-ns = <44>;
		gpmc,oe-off-ns = <54>;
		gpmc,we-off-ns = <40>;
		gpmc,rd-cycle-ns = <82>;
		gpmc,wr-cycle-ns = <82>;
		gpmc,access-ns = <64>;
		gpmc,wr-access-ns = <40>;
		gpmc,wr-data-mux-bus-ns = <0>;

		partition@0 {
			label = "boot";
			reg = <0x0 0x300000>;
		};

		partition@300000 {
			label = "nandkernel";
			reg = <0x300000 0xb00000>;
		};

		partition@e00000 {
			label = "sdkernel";
			reg = <0xe00000 0xb00000>;
		};

		partition@1900000 {
			label = "bootstrap";
			reg = <0x1900000 0x5c00000>;
		};

		partition@7500000 {
			label = "scratch";
			reg = <0x7500000 0xb00000>;
		};

		partition@8000000 {
			label = "controlblock";
			reg = <0x8000000 0x400000>;
		};
	};
};

/* I2C1 is the PMIC bus, at 2.6 MHz (the TWL4030's high-speed mode). */
&i2c1 {
	clock-frequency = <2600000>;
	pinctrl-names = "default";
	pinctrl-0 = <&pinmux_i2c1_pins>;

	twl: twl@48 {
		reg = <0x48>;
		interrupt-parent = <&intc>;
		interrupts = <7>;	/* sys_nirq */
	};
};

/* The mainline description of the TWL4030's functions; it fills in the &twl declared above. */
#include "twl4030.dtsi"

/* I2C2: the Panjit touch controller. Its driver is kernel/drivers/cy8ctmg120_ts. */
&i2c2 {
	clock-frequency = <400000>;
	pinctrl-names = "default";
	pinctrl-0 = <&pinmux_i2c2_pins>;

	tsc_panjit@03 {
		compatible = "panjit_ts";
		reg = <0x03>;
		pinctrl-names = "default";
		pinctrl-0 = <&pinmux_ts_rst_pins>;
		interrupt-parent = <&gpio1>;
		interrupts = <23 IRQ_TYPE_EDGE_FALLING>;
		gpios = <&gpio1 23 GPIO_ACTIVE_LOW>;
		reset-gpios = <&gpio1 16 GPIO_ACTIVE_HIGH>;
	};
};

&i2c3 {
	status = "disabled";
};

&twl {
	/*
	 * `poweroff` asks the PMIC to switch the board off: with this child, twl4030-power binds and
	 * ti,system-power-controller sets pm_power_off to twl4030_power_off (DEVOFF). The generic
	 * compatible loads no sleep or warm-reset scripts and configures no resources.
	 */
	power {
		compatible = "ti,twl4030-power";
		ti,system-power-controller;
	};

	audio {
		compatible = "ti,twl4030-audio";
		codec {
		};
	};
};

/* The backup-battery cell the charger tops up: 3.2 V at 500 uA. */
&charger {
	ti,bb-uvolt = <3200000>;
	ti,bb-uamp = <500>;
};

/* VAUX2 is the EHCI supply, VPLL2 the DSS PLL supply; both stay on. */
&vaux2 {
	regulator-name = "vdd_ehci";
	regulator-min-microvolt = <1800000>;
	regulator-max-microvolt = <1800000>;
	regulator-always-on;
};

&vpll2 {
	regulator-name = "vdds_dsi";
	regulator-always-on;
};

&mmc1 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinmux_mmc1_cd_pin>;
	vmmc-supply = <&vmmc1>;
	vmmc_aux-supply = <&vsim>;
	bus-width = <4>;
	cd-gpios = <&gpio4 31 GPIO_ACTIVE_LOW>;
	/* The slot has no write-protect line; without this every card insert logs a warning. */
	disable-wp;
};

&mmc2 {
	status = "disabled";
};

&mmc3 {
	status = "disabled";
};

&mcbsp2 {
	status = "okay";
};

/* The console is UART2 (ttyO1). */
&uart1 {
	status = "disabled";
};

&uart2 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&pinmux_uart2_pins>;
};

&uart3 {
	status = "disabled";
};

/*
 * USB OTG on the TWL4030 ULPI PHY, dual role. `power` is in units of 2 mA: 250 is the 500 mA a
 * USB 2.0 port may offer, which musb_host_setup() turns into the root hub's bus power budget.
 * Both host-controller ports run through external PHYs. pinctrl-1 names the VBUS-enable pad (gpio13),
 * but only the "default" state is ever selected, so that pad is left as the bootloader set it.
 */
&usb_otg_hs {
	interface-type = <0>;
	mode = <3>;
	power = <250>;
	usb-phy = <&usb2_phy>;
	phys = <&usb2_phy>;
	phy-names = "usb2-phy";
	pinctrl-names = "default";
	pinctrl-0 = <&pinmux_hsusb_otg_pins>;
	pinctrl-1 = <&pinmux_vbus_enable_pins>;
};

&usbhshost {
	port1-mode = "ehci-phy";
	port2-mode = "ehci-phy";
};
