# Key-only root login. This OpenSSH is built without PAM, so there is no UsePAM line.
# The host keys are symlinks into /home/root/data/ssh, a directory on the root partition
# (p3), so they are lost on a reflash with the rest of the unit; /etc/init.d/sshd generates them on first start.
HostKey /etc/ssh/ssh_host_ed25519_key
PidFile /var/run/sshd.pid
PermitRootLogin prohibit-password
PubkeyAuthentication yes
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitEmptyPasswords no
AuthorizedKeysFile .ssh/authorized_keys
Subsystem sftp /usr/libexec/sftp-server
