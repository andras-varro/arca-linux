proc             /proc             proc     defaults                     0      0
sysfs            /sys              sysfs    defaults                     0      0
devpts           /dev/pts          devpts   mode=0620,gid=5              0      0
tmpfs            /var/volatile     tmpfs    defaults,nodev               0      0
tmpfs            /dev/shm          tmpfs    mode=0777                    0      0
/dev/mmcblk0p2   /home/root/data   ext4     defaults,nodev,noatime       0      0
/dev/mmcblk0p3   /home/root/log    ext4     defaults,nodev,noatime       0      0
