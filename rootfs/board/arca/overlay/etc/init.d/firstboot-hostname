#!/bin/sh
# First boot of a generic image: give the unit a name of its own. The image carries the build
# placeholder as /etc/hostname; while that (or nothing) is the name, pick arca-<4 hex> from
# the kernel's random pool and apply it with set-hostname. Any other name is somebody's choice
# (a per-unit image, the Control Panel) and is left alone, so every later boot prints nothing.
# Runs before S04hostname, after seedrng has credited the pool. The ARCA_* variables point the
# script at a fixture for the host test; on the unit they are unset.
PLACEHOLDER=arca
PREFIX=${ARCA_ROOT:-}
SETTER=${ARCA_SET_HOSTNAME:-/usr/sbin/set-hostname}
URANDOM=${ARCA_URANDOM:-/dev/urandom}

case "$1" in
    start)
        cur=
        [ -f "$PREFIX/etc/hostname" ] && cur=$(head -n 1 "$PREFIX/etc/hostname" | tr -d ' \t\r')
        if [ -n "$cur" ] && [ "$cur" != "$PLACEHOLDER" ]; then exit 0; fi
        sfx=$(tr -dc 'a-f0-9' < "$URANDOM" 2> /dev/null | dd bs=1 count=4 2> /dev/null)
        if [ "${#sfx}" -ne 4 ]; then
            echo "firstboot-hostname: no random bytes, keeping '${cur:-unnamed}'" >&2
            exit 0
        fi
        name="arca-$sfx"
        if "$SETTER" "$name" ${PREFIX:+"$PREFIX"} > /dev/null; then
            echo "host name: $name (first boot)"
        else
            echo "firstboot-hostname: could not set $name" >&2
        fi
        ;;
    stop|restart|reload) ;;
    *) echo "Usage: $0 {start|stop|restart|reload}" >&2; exit 1 ;;
esac
exit 0
