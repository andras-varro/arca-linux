#!/bin/sh
# OpenSSH server. Host keys live on the data partition (/home/root/data/ssh) so they survive
# a reflash of the root filesystem; /etc/ssh/ssh_host_*_key link there. If that partition
# is not mounted, the keys go to the tmpfs and sshd still starts, with fresh keys each boot.
# The marker /etc/ssh/sshd_off (made by the Control Panel) keeps `start` from starting it.
DAEMON=/usr/sbin/sshd
PIDFILE=/var/run/sshd.pid
KEYDIR=/home/root/data/ssh

genkeys() {
    if mountpoint -q /home/root/data; then
        dir=$KEYDIR
    else
        dir=/var/run/ssh
        logger -t sshd "data partition not mounted: host keys on tmpfs"
    fi
    mkdir -p "$dir"
    chmod 700 "$dir"
    # The links in /etc/ssh point at $KEYDIR, so the fallback keys must be reachable there.
    if [ "$dir" != "$KEYDIR" ]; then
        mkdir -p "$KEYDIR"
        ln -sf "$dir/ssh_host_ed25519_key" "$KEYDIR/ssh_host_ed25519_key"
        ln -sf "$dir/ssh_host_ed25519_key.pub" "$KEYDIR/ssh_host_ed25519_key.pub"
    fi
    # ed25519 only: an RSA key doubled the first-boot wait, which is entropy-bound.
    if [ ! -s "$dir/ssh_host_ed25519_key" ]; then
        echo "sshd: generating ed25519 host key"
        ssh-keygen -q -t ed25519 -N "" -f "$dir/ssh_host_ed25519_key"
    fi
}

case "$1" in
    start)
        [ -x "$DAEMON" ] || exit 0
        if [ -e /etc/ssh/sshd_off ]; then
            echo "sshd: off (Control Panel)"
            exit 0
        fi
        genkeys
        mkdir -p /var/empty
        if ! "$DAEMON" -t; then
            logger -t sshd "configuration or host key check failed: not starting"
            exit 1
        fi
        start-stop-daemon -S -q -p "$PIDFILE" -x "$DAEMON"
        ;;
    stop)
        PID=$(cat "$PIDFILE" 2>/dev/null)
        if [ -n "$PID" ]; then
            start-stop-daemon -K -q -p "$PIDFILE"
            # Wait up to ~5 seconds for the process to exit
            n=0
            while [ "$n" -lt 50 ]; do
                kill -0 "$PID" 2>/dev/null || break
                n=$((n + 1))
                sleep 0.1
            done
        fi
        rm -f "$PIDFILE"
        ;;
    restart)
        "$0" stop
        "$0" start
        ;;
    reload)
        start-stop-daemon -K -q -s HUP -p "$PIDFILE"
        ;;
    *) echo "Usage: $0 {start|stop|restart|reload}" >&2; exit 1 ;;
esac
exit 0
