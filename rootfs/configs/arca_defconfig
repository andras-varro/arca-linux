# Root filesystem for the Arca: TI OMAP3503, Cortex-A8, no hardware integer divide.
# Soft-float EABI (not EABIHF) because the deployed dynamic binaries need /lib/ld-linux.so.3.
BR2_arm=y
BR2_cortex_a8=y
BR2_ARM_EABI=y
BR2_ARM_FPU_NEON=y
BR2_ARM_INSTRUCTIONS_THUMB2=y

BR2_DL_DIR="$(HOME)/br-dl"
# Keep the symbol table: native_apps/check-arm-safe.sh cannot judge a stripped binary.
# BR2_STRIP_strip is not set

# Internal glibc toolchain; headers match the running kernel.
BR2_KERNEL_HEADERS_VERSION=y
BR2_DEFAULT_KERNEL_VERSION="4.14.52"
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_4_14=y
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y

# The kernel and bootloader are built elsewhere (kernel/build-image.sh).
# BR2_LINUX_KERNEL is not set

BR2_TARGET_GENERIC_HOSTNAME="arca"
BR2_TARGET_GENERIC_ISSUE="Ludbox Linux"
BR2_INIT_BUSYBOX=y
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_EUDEV=y
# No serial console is reachable on the unit.
# BR2_TARGET_GENERIC_GETTY is not set
# Empty here; post-build.sh locks the account (key-only login).
BR2_TARGET_GENERIC_ROOT_PASSWD=""
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_ARCA_PATH)/board/arca/overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_ARCA_PATH)/board/arca/post-build.sh"

# The deploy scripts run their remote halves as `ssh "$DEVICE" bash <<'REMOTE'`.
# bash depends on SHOW_OTHERS (it only unhides packages BusyBox overlaps); without it
# defconfig drops BR2_PACKAGE_BASH silently.
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
BR2_PACKAGE_BASH=y
BR2_PACKAGE_OPENSSH=y
BR2_PACKAGE_DBUS=y
BR2_PACKAGE_AVAHI=y
BR2_PACKAGE_AVAHI_DAEMON=y
BR2_PACKAGE_ALSA_LIB=y
BR2_PACKAGE_ALSA_UTILS=y
BR2_PACKAGE_ALSA_UTILS_AMIXER=y
BR2_PACKAGE_ALSA_UTILS_ALSACTL=y
BR2_PACKAGE_LIBGLIB2=y
BR2_PACKAGE_READLINE=y
BR2_TARGET_TZ_INFO=y
BR2_PACKAGE_ETHTOOL=y

BR2_TARGET_ROOTFS_TAR=y
# BR2_TARGET_ROOTFS_EXT2 is not set
