diff --git a/arch/arm/dts/omap3-rw20.dts b/arch/arm/dts/omap3-rw20.dts
new file mode 100644
index 00000000..23be569f
--- /dev/null
+++ b/arch/arm/dts/omap3-rw20.dts
@@ -0,0 +1,55 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Steelcase RoomWizard (rw20), U-Boot only: memory, UART2 console, MMC1
+ * and the TWL4030 on I2C1. Not the kernel DTB.
+ */
+/dts-v1/;
+
+#include "omap34xx.dtsi"
+/ {
+	model = "Steelcase RoomWizard rw20";
+	compatible = "steelcase,rw20", "ti,omap3430", "ti,omap3";
+
+	memory@80000000 {
+		device_type = "memory";
+		reg = <0x80000000 0x10000000>;	/* 256 MB */
+	};
+};
+
+&i2c1 {
+	clock-frequency = <400000>;
+
+	twl: twl@48 {
+		reg = <0x48>;
+		interrupts = <7>;	/* SYS_NIRQ cascaded to intc */
+	};
+};
+
+&i2c2 {
+	status = "disabled";
+};
+
+&i2c3 {
+	status = "disabled";
+};
+
+#include "twl4030.dtsi"
+#include "twl4030_omap3.dtsi"
+
+&mmc1 {
+	vmmc-supply = <&vmmc1>;
+	vqmmc-supply = <&vsim>;
+	bus-width = <4>;
+};
+
+&mmc2 {
+	status = "disabled";
+};
+
+&mmc3 {
+	status = "disabled";
+};
+
+&wdt2 {
+	status = "disabled";
+};
