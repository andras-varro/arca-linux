diff --git a/board/steelcase/rw20/rw20.c b/board/steelcase/rw20/rw20.c
new file mode 100644
index 00000000..f648e065
--- /dev/null
+++ b/board/steelcase/rw20/rw20.c
@@ -0,0 +1,141 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Steelcase RoomWizard (OMAP3503, TWL4030, 256 MB DDR on CS0).
+ * Structure follows board/timll/devkit8000; SDRC values are the ones the
+ * vendor U-Boot leaves in the controller (read live over devmem).
+ */
+#include <config.h>
+#include <dm.h>
+#include <init.h>
+#include <ns16550.h>
+#include <twl4030.h>
+#include <asm/global_data.h>
+#include <asm/io.h>
+#include <asm/arch/mmc_host_def.h>
+#include <asm/arch/mux.h>
+#include <asm/arch/sys_proto.h>
+#include <asm/arch/mem.h>
+#include <asm/arch/gpio.h>
+#include <asm/mach-types.h>
+
+DECLARE_GLOBAL_DATA_PTR;
+
+#include "rw20-mux.h"
+
+/*
+ * Boot-stage witness: the two side LEDs are SoC GPTimer PWM pads (not TWL4030):
+ * red = MCSPI2_SOMI (GPT10), green = MCSPI2_CS0 (GPT11); in mode 4 they are
+ * gpio_180 / gpio_181 = GPIO6 bits 20 / 21, active high. Pad addresses =
+ * OMAP34XX_CTRL_BASE 0x48002000 + CP() 0x1DA / 0x1DC (asm/arch/mux.h), 16-bit
+ * writes. GPIO6 = OMAP34XX_GPIO6_BASE 0x49058000 (OE +0x34, CLEARDATAOUT
+ * +0x90, SETDATAOUT +0x94). Clocks: CM_FCLKEN_PER 0x48005000 / CM_ICLKEN_PER
+ * 0x48005010 bit 17 (EN_GPIO6; PRCM_BASE 0x48004000 + struct prcm 0x1000 /
+ * 0x1010). Needs no I2C, no SDRAM, no serial.
+ * Readings: dark = SPL never got here; red = SPL stuck before/at SDRAM;
+ * red+green = SDRAM ok, stuck loading u-boot.img; green = U-Boot proper runs,
+ * stuck before bootm; dark again = kernel handed off.
+ */
+#define RW20_GPIO6		OMAP34XX_GPIO6_BASE
+#define RW20_LED_RED		(1 << 20)
+#define RW20_LED_GREEN		(1 << 21)
+
+static void rw20_gpio6_enable(void)
+{
+	setbits_le32(PRCM_BASE + 0x1000, 1 << 17);	/* CM_FCLKEN_PER: EN_GPIO6 */
+	setbits_le32(PRCM_BASE + 0x1010, 1 << 17);	/* CM_ICLKEN_PER: EN_GPIO6 */
+}
+
+/* Both pads to mode 4 (a pinmux replay puts them back to mode 1), then drive. */
+void rw20_led(int red, int green)
+{
+	rw20_gpio6_enable();
+	writew(M4, OMAP34XX_CTRL_BASE + CP(MCSPI2_SOMI));
+	writew(M4, OMAP34XX_CTRL_BASE + CP(MCSPI2_CS0));
+	clrbits_le32(RW20_GPIO6 + OMAP_GPIO_OE, RW20_LED_RED | RW20_LED_GREEN);
+	writel((red ? RW20_LED_RED : 0) | (green ? RW20_LED_GREEN : 0),
+	       RW20_GPIO6 + OMAP_GPIO_SETDATAOUT);
+	writel((red ? 0 : RW20_LED_RED) | (green ? 0 : RW20_LED_GREEN),
+	       RW20_GPIO6 + OMAP_GPIO_CLEARDATAOUT);
+}
+
+int board_init(void)
+{
+	/* U-Boot proper runs: red off, green on (proper's s_init replayed the pads to mode 1) */
+	rw20_led(0, 1);
+	gpmc_init();
+	/* DT kernel with appended DTB ignores this; Overo lineage of the vendor build */
+	gd->bd->bi_arch_number = MACH_TYPE_OVERO;
+	gd->bd->bi_boot_params = (OMAP34XX_SDRC_CS0 + 0x100);
+	return 0;
+}
+
+int misc_init_r(void)
+{
+	twl4030_power_init();
+	omap_die_id_display();
+	return 0;
+}
+
+/* Replay of the live padconf (32-bit writes, two pads per word). */
+void set_muxconf_regs(void)
+{
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(rw20_padconf); i++)
+		writel(rw20_padconf[i].val, rw20_padconf[i].addr);
+}
+
+#if defined(CONFIG_MMC)
+int board_mmc_init(struct bd_info *bis)
+{
+	return omap_mmc_init(0, 0, 0, -1, -1);
+}
+
+void board_mmc_power_init(void)
+{
+	twl4030_power_mmc_init(0);
+}
+#endif
+
+
+#ifdef CONFIG_XPL_BUILD
+static int rw20_ram_ok(void)
+{
+	static const u32 addr[] = { 0x80300000, 0x84000000, 0x88000000,
+				    0x8FF00000 };
+	int i, ok = 1;
+
+	for (i = 0; i < 4; i++) {
+		volatile u32 *p = (volatile u32 *)addr[i];
+
+		*p = 0xA5A5C3C3 ^ i;
+		p[1] = ~(0xA5A5C3C3 ^ i);
+	}
+	for (i = 0; i < 4; i++) {
+		volatile u32 *p = (volatile u32 *)addr[i];
+
+		if (*p != (0xA5A5C3C3 ^ i) || p[1] != ~(0xA5A5C3C3 ^ i))
+			ok = 0;
+	}
+	return ok;
+}
+
+/* stage 1: s_init (after pinmux replay and clocks), red on; stage 2: SDRAM ok, add green */
+void rw20_witness(int stage)
+{
+	if (stage == 1)
+		rw20_led(1, 0);
+	else if (stage == 2 && rw20_ram_ok())
+		rw20_led(1, 1);
+}
+#endif
+
+/* SDRC values read from the running unit (SDRC_MCFG_0, ACTIM_CTRLA/B_0, RFR_CTRL_0, MR_0) */
+void get_board_mem_timings(struct board_sdrc_timings *timings)
+{
+	timings->mcfg = 0x03588099;
+	timings->ctrla = 0x7AE1B4C6;
+	timings->ctrlb = 0x00024217;
+	timings->rfr_ctrl = 0x0005E601;
+	timings->mr = 0x32;
+}
