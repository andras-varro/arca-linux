# VNC Client for Ludbox Linux - Configuration TEMPLATE
#
# Copy this file to `vnc_client.conf` and edit it with your own values:
#
#     cp vnc_client.conf.example vnc_client.conf
#
# `vnc_client.conf` is gitignored so your password never reaches the repo.
# The deploy script installs it to /opt/vnc_client/vnc_client.conf on the
# device (only if that file does not already exist there).
#
# All settings can also be overridden via command-line arguments:
#   vnc_client --host <ip> --port <port> --password <pw>
#   vnc_client <host> [port]   (legacy positional syntax)
#
# Lines starting with # are comments. Whitespace around = is ignored.

# VNC server hostname or IP address
host = 192.168.1.100

# VNC server port (x11vnc on 5900)
port = 5900

# VNC authentication password (VncAuth / security type 2).
# Must match the password configured on the VNC server.
#
# NOTE: this is stored in plaintext on the device and is sent using the
# legacy VncAuth scheme. Use a throwaway password, not one you reuse.
password = CHANGEME

# Preferred encodings (most preferred first)
# Options: tight, zrle, copyrect, hextile, zlib, raw
encodings = tight zrle copyrect hextile zlib raw

# Tight encoding compression level (1-9, higher = more compression)
compress_level = 6

# Tight encoding JPEG quality (1-9, higher = better quality)
quality_level = 5

# Where the remote desktop is drawn: safe | visible
#
#   safe    (default) letterbox it into the TOUCH-SAFE rectangle, so every pixel
#           of the remote desktop can be reached by a finger. The digitizer
#           saturates before the panel edge — a band at each end is visible but
#           not pressable — and a remote taskbar on the bottom row has to be
#           clickable. Costs some size: a 1920x1080 desktop scales to ~747x420
#           instead of ~795x447.
#   visible use the whole visible surface. Bigger, sharper text, but a band at
#           the top and bottom of the remote desktop cannot be tapped.
#
# Only affects the remote desktop. This app's own touch UI — the settings
# screen, the reconnect buttons and the exit gesture corner — always stays
# inside the touch-safe rectangle.
#
# Has no effect until the panel's edge reach has been measured (Control Panel ->
# Display -> CALIBRATE TOUCH, the REACH step); before that the two are the same.
#
# Editable on the device: settings GUI -> CONTENT row -> TOGGLE, then
# SAVE & RECONNECT (the picture is laid out once per session).
content_area = safe
